# Copy this file to .env at the repo root before running.

# ==== Database (Postgres in Docker) ====
DATABASE_URL="postgresql://metu:metu@localhost:5432/metu?schema=public"

# ==== API ====
API_PORT=4000
API_URL="http://localhost:4000"
JWT_SECRET="dev-only-replace-me-with-32-bytes-minimum-for-demo"
COOKIE_DOMAIN=localhost
CORS_ORIGIN="http://localhost:3000"

# ==== Google OAuth (optional — Phase 18) ====
# Provision at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match EXACTLY (case-sensitive, no trailing slash):
#   Local dev:  http://localhost:3000/api/auth/better/callback/google
#   Production: https://metu.fly.dev/api/auth/better/callback/google
# Leave UNSET to disable Google sign-in entirely — login button hides automatically
# (boolean is exposed via /api/settings as `googleEnabled`).
# Setup walkthrough: docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override — defaults to BFF base URL (http://localhost:3000 dev / https://metu.fly.dev prod)
# BETTER_AUTH_URL=http://localhost:3000
# Optional — distinct 32+ byte secret for production. Falls back to JWT_SECRET in dev.
# BETTER_AUTH_SECRET=

# ==== Web ====
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_PORT=3000

# ==== Stripe (test mode — Phase 27) ====
# Provision a test-mode account at https://dashboard.stripe.com/test/apikeys
# Both keys live alongside the publishable key on the same dashboard page.
# The test secret + publishable both start with `sk_test_` / `pk_test_`.
# Webhook secret comes from https://dashboard.stripe.com/test/webhooks
# after you register an endpoint pointing at /api/webhooks/stripe.
# Leave UNSET to keep checkout in demo mode (orders go straight to `paid`,
# no Stripe charge). Stripe Connect onboarding + refund + seller-wallet
# pages will all show a "not configured" banner instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional — base URL the seller is redirected to after Stripe-hosted
# Connect onboarding completes / link expires. Defaults to
# NEXT_PUBLIC_SITE_URL.
# STRIPE_CONNECT_RETURN_BASE=http://localhost:3000

# ==== Node ====
NODE_ENV=development

# ==== Resend (transactional email — Phase 33) ====
# Provision at https://resend.com/api-keys. Used for OTP delivery,
# password-reset / set-password mails, admin step-up OTPs, and
# Stripe Connect onboarding nudges. Leave UNSET to fall through to
# OTP_TRANSPORT=console (server logs the OTP code instead of mailing).
RESEND_API_KEY=
RESEND_FROM=

# ==== Firebase Admin (server-side phone-OTP issue + verify, Phase 46) ====
# Single-line JSON service-account blob from the Firebase Console
# (Project Settings → Service accounts → Generate new key).
# Leave UNSET to disable Firebase phone OTP — phone-based 2FA falls
# through to TWILIO_* below or to console-mode in dev.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==== Admin OTP guard (Phase 28) ====
# Where admin step-up OTPs (recent-2FA gate) are mailed.
ADMIN_OTP_RECIPIENT_EMAIL=
# Comma-separated allow-list of admin emails that get mailed instead
# of the single recipient above (one of them must match the actor's
# email or the OTP issue is denied).
ADMIN_OTP_GUARD_EMAILS=
# DEV ONLY — when "true", /admin/otp/issue returns the plaintext OTP
# in the JSON response so the demo flow doesn't need a real mailbox.
# MUST be unset / "false" in production.
ADMIN_OTP_DEV_REVEAL=false

# ==== Demo / preview helpers ====
# Comma-separated allow-list of "X-Demo-Token" header values that
# bypass certain auth gates for the proctored demo flow. Leave UNSET
# in production.
DEMO_REVEAL_TOKENS=

# ==== Cloudflare Turnstile (CAPTCHA — Phase 25) ====
# Server secret from the Turnstile dashboard. Pair with the public
# NEXT_PUBLIC_TURNSTILE_SITE_KEY (web-side). Leave UNSET to disable
# captcha enforcement on /login, /register, and /reset-password.
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ==== Better-Auth ====
# Comma-separated allow-list of trusted origins for the better-auth
# session-cookie flow. Defaults to CORS_ORIGIN above when unset.
BETTER_AUTH_TRUSTED_ORIGINS=

# ==== OTP / SMS transport (Phase 19/46) ====
# One of: console | resend | twilio | firebase. Defaults to "console"
# in dev (logs OTP to stdout) and "resend" in production.
OTP_TRANSPORT=console
# Twilio fallback for SMS phone-OTP. Leave UNSET to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ==== Build / deploy stamp (read-only at runtime) ====
# Set automatically by Fly's release process — appears in /health and
# in client-rendered footers. Don't set these locally; they should
# stay empty in dev so the UI shows "dev build".
FLY_RELEASE_VERSION=
GIT_SHA=

# ==== BFF → API internal URL (production only) ====
# When the BFF and API are deployed as separate Fly apps, the BFF's
# server-side fetches go through the private 6PN network instead of
# the public hostname. Defaults to NEXT_PUBLIC_API_URL in dev.
INTERNAL_API_URL=
