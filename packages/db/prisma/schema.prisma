// METU Digital Marketplace - Prisma schema.
// snake_case in DB, camelCase in JS via @map.
// Cascading deletes apply where child rows depend on the parent.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum Gender {
  male
  female
  other
}

enum UserRole {
  buyer
  seller
  admin
}

enum CartStatus {
  active
  checked_out
  expired
}

enum OrderStatus {
  pending
  paid
  fulfilled
  cancelled
  refunded
}

enum TransactionType {
  purchase
  payout
}

enum DeliveryMethod {
  download
  email
  license_key
  streaming
}

enum DiscountType {
  percent
  fixed
}

// ============================================================================
//  CORE IDENTITY
// ============================================================================

model Country {
  countryId   Int    @id @default(autoincrement()) @map("country_id")
  countryCode Int    @map("country_code")
  name        String @db.VarChar(60)

  users User[]

  @@map("country")
}

model User {
  userId               Int       @id @default(autoincrement()) @map("user_id")
  countryId            Int?      @map("country_id")
  // Nullable: Google-only signups have no password until they Set Password.
  password             String?   @db.Text
  username             String    @unique @db.VarChar(20)
  firstName            String    @map("first_name") @db.VarChar(40)
  lastName             String    @map("last_name") @db.VarChar(40)
  email                String    @unique @db.VarChar(80)
  // better-auth flag; password login doesn't gate on it, Google sign-in flips true.
  emailVerified        Boolean   @default(false) @map("email_verified")
  gender               Gender?
  profileImage         String?   @map("profile_image") @db.Text
  dateOfBirth          DateTime? @map("date_of_birth")
  // Phone + verification timestamp.
  phone                String?   @db.VarChar(20)
  phoneVerifiedAt      DateTime? @map("phone_verified_at")
  // SHA-256 of the 6-digit OTP at register, 10-min TTL. Cleared when
  // phoneVerifiedAt is stamped.
  phoneOtpHash         String?   @map("phone_otp_hash") @db.VarChar(64)
  phoneOtpExpiresAt    DateTime? @map("phone_otp_expires_at")
  // TOTP 2FA. NULL secret = never enrolled.
  totpSecret           String?   @map("totp_secret") @db.VarChar(64)
  totpEnabled          Boolean   @default(false) @map("totp_enabled")
  // Admin-imposed force-reset flag. While true, the BFF redirects
  // every authed page to /profile/edit until the user changes pwd.
  requirePasswordReset Boolean   @default(false) @map("require_password_reset")
  createdDate          DateTime  @default(now()) @map("created_date")
  // Required by better-auth's adapter on every model.
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Soft-delete: hides user from public surfaces, keeps order/review FKs intact.
  deletedAt DateTime? @map("deleted_at")

  // Moderation metadata. NULL for active users + self-deletes;
  // populated only by admin-driven removals (profanity, fraud, abuse).
  bannedAt     DateTime? @map("banned_at")
  bannedReason String?   @map("banned_reason") @db.VarChar(120)

  country             Country?             @relation(fields: [countryId], references: [countryId])
  stats               UserStats?
  store               Store?
  carts               Cart[]
  orders              Order[]
  transactions        Transaction[]
  reviews             ProductReview[]
  couponUsages        CouponUsage[]
  favorites           ProductFavorite[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]
  auditLogs           AuditLog[]

  // better-auth relations.
  accounts Account[]
  sessions Session[]

  // Phase 48 — admin who issued IP bans (network-layer abuse blocks).
  bannedIpsIssued BannedIp[] @relation("BannedIpBy")

  // Phase 49 — devices the user has confirmed via the email-OTP gate
  // and chosen to "trust for 7 days" so they don't re-OTP every login.
  trustedDevices  TrustedDevice[]

  @@index([countryId])
  @@index([createdDate])
  @@index([deletedAt])
  @@index([bannedAt])
  @@map("users")
}

model UserStats {
  userId      Int      @id @map("user_id")
  buyerLevel  Int      @default(1) @map("buyer_level")
  sellerLevel Int      @default(0) @map("seller_level")
  role        UserRole @default(buyer)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([role])
  @@map("user_stats")
}

// ============================================================================
//  STORE
// ============================================================================

model BusinessType {
  typeId      Int    @id @default(autoincrement()) @map("type_id")
  name        String @db.VarChar(30)
  description String @db.VarChar(150)

  stores Store[]

  @@map("business_type")
}

model Store {
  storeId              Int       @id @default(autoincrement()) @map("store_id")
  ownerId              Int       @unique @map("owner_id")
  businessTypeId       Int       @map("business_type_id")
  name                 String    @db.VarChar(60)
  description          String    @db.VarChar(255)
  profileImage         String?   @map("profile_image") @db.Text
  coverImage           String?   @map("cover_image") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  // Soft-delete: hides from public surfaces, keeps history intact.
  deletedAt            DateTime? @map("deleted_at")
  // Suspended: hidden from buyers, still visible to the seller. Reversible.
  suspendedAt          DateTime? @map("suspended_at")
  /// Stripe Connect Express account. NULL = not onboarded yet.
  /// Charges + payouts gated on the capability flags below.
  stripeAccountId      String?   @unique @map("stripe_account_id") @db.VarChar(40)
  stripePayoutsEnabled Boolean   @default(false) @map("stripe_payouts_enabled")
  stripeChargesEnabled Boolean   @default(false) @map("stripe_charges_enabled")

  // Optional public contact channels surfaced in the buyer's receipt.
  contactEmail         String?   @map("contact_email") @db.VarChar(120)
  phone                String?   @db.VarChar(20)
  // avg review rating × 10 (e.g. 48 = 4.8★). Recomputed on review insert.
  rating               Int       @default(0)

  owner        User         @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  businessType BusinessType @relation(fields: [businessTypeId], references: [typeId])
  products     Product[]
  coupons      Coupon[]

  @@index([businessTypeId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("store")
}

// ============================================================================
//  CATALOG
// ============================================================================

model Category {
  categoryId   Int    @id @default(autoincrement()) @map("category_id")
  categoryName String @map("category_name") @db.VarChar(40)
  description  String @db.VarChar(150)

  products Product[]

  @@map("category")
}

model ProductTag {
  tagId          Int    @id @default(autoincrement()) @map("tag_id")
  tagName        String @unique @map("tag_name") @db.VarChar(30)
  tagDescription String @map("tag_description") @db.VarChar(150)

  productNTags ProductNTag[]

  @@map("product_tag")
}

model Product {
  productId      Int            @id @default(autoincrement()) @map("product_id")
  storeId        Int            @map("store_id")
  categoryId     Int            @map("category_id")
  name           String         @db.VarChar(100)
  description    String         @db.VarChar(255)
  // Paused products hide from public surfaces; seller dashboard still shows them.
  isActive       Boolean        @default(true) @map("is_active")
  // Phase 45 — promoted from ProductItem to match the docx report.
  // ProductItem still keeps its own deliveryMethod for the moment so
  // existing services that read variant-level delivery don't break;
  // both columns stay in sync (or the seller form picks one truth).
  deliveryMethod DeliveryMethod @map("delivery_method")
  // Phase 45 — Business Rule: products with isStackable=false cap
  // each line at quantity=1 (e.g. one-off pitch decks, single-seat
  // license keys). True for assets a buyer can buy multiple copies of.
  isStackable    Boolean        @default(true) @map("is_stackable")
  // Soft-delete: hidden everywhere except order history / reviews / favourites.
  deletedAt      DateTime?      @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  // Owned by the product_touch_updated_at trigger; no @updatedAt
  // so Prisma never writes it from the app side.
  updatedAt DateTime @default(now()) @map("updated_at")

  store        Store             @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [categoryId])
  items        ProductItem[]
  images       ProductImage[]
  reviews      ProductReview[]
  productNTags ProductNTag[]
  favorites    ProductFavorite[]
  details      ProductDetail[]

  @@index([storeId])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("product")
}

/// Phase 45 — "Product Additional Detail" per the docx report. Lets a
/// seller list extra spec rows (file format, license duration, file
/// size). Business Rule 4(g) caps it at 7 rows per product, enforced
/// at the application layer.
model ProductDetail {
  productDetailId Int    @id @default(autoincrement()) @map("product_detail_id")
  productId       Int    @map("product_id")
  detailName      String @map("detail_name") @db.VarChar(80)
  detailValue     String @map("detail_value") @db.VarChar(255)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
  @@map("product_detail")
}

model ProductItem {
  productItemId   Int            @id @default(autoincrement()) @map("product_item_id")
  productId       Int            @map("product_id")
  // Phase 45 — variant-level fields per the docx report. `name` is
  // required (e.g. "Standard", "Pro", "Team"); description + image
  // are optional and let the seller distinguish variants visually.
  name            String         @db.VarChar(100)
  description     String?        @db.VarChar(255)
  image           String?        @db.Text
  // Variant-level delivery method stays for backwards compat with
  // services that read it directly. The canonical value is on
  // Product (per the report); the two should be kept in sync.
  deliveryMethod  DeliveryMethod @map("delivery_method")
  quantity        Int            @default(0)
  price           Decimal        @db.Decimal(10, 2)
  discountPercent Int            @default(0) @map("discount_percent")
  discountAmount  Decimal        @default(0) @map("discount_amount") @db.Decimal(10, 2)
  // Public preview link (low-res PDF, audio clip, etc.).
  sampleUrl       String?        @map("sample_url") @db.Text
  // Private post-purchase link + license-key template.
  // Template "METU-XXXX-XXXX-XXXX" replaces XXXX with random alphanumerics;
  // null template falls back to a UUID v4.
  deliveryUrl         String?    @map("delivery_url") @db.Text
  licenseKeyTemplate  String?    @map("license_key_template") @db.VarChar(80)
  createdDate     DateTime       @default(now()) @map("created_date")

  product    Product     @relation(fields: [productId], references: [productId], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@map("product_item")
}

// Many images per product (extension of the ER diagram which had one).
model ProductImage {
  productImageId Int    @id @default(autoincrement()) @map("product_image_id")
  productId      Int    @map("product_id")
  productImage   String @map("product_image") @db.Text
  sortOrder      Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId])
  @@map("product_image")
}

model ProductReview {
  reviewId  Int      @id @default(autoincrement()) @map("review_id")
  productId Int      @map("product_id")
  userId    Int      @map("user_id")
  rating    Int
  comment   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@map("product_review")
}

model ProductNTag {
  junctionId Int @id @default(autoincrement()) @map("junction_id")
  productId  Int @map("product_id")
  tagId      Int @map("tag_id")

  product Product    @relation(fields: [productId], references: [productId], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [tagId], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
  @@map("product_n_tag")
}

// User wishlist. Separate from cart; favourite means "come back to this".
model ProductFavorite {
  favoriteId Int      @id @default(autoincrement()) @map("favorite_id")
  userId     Int      @map("user_id")
  productId  Int      @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("product_favorite")
}

// ============================================================================
//  CART / ORDER / TRANSACTION
// ============================================================================

model Cart {
  cartId    Int        @id @default(autoincrement()) @map("cart_id")
  userId    Int        @map("user_id")
  status    CartStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  expiredAt DateTime?  @map("expired_at")
  sessionId Int?       @map("session_id")

  user  User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items CartItem[]

  // At most one active cart per user (enforced in the app layer).
  @@index([userId, status])
  @@index([status])
  @@map("cart")
}

// Explicit cart-lines model (extension of the original ER diagram).
model CartItem {
  cartItemId    Int      @id @default(autoincrement()) @map("cart_item_id")
  cartId        Int      @map("cart_id")
  productItemId Int      @map("product_item_id")
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")

  cart        Cart        @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  productItem ProductItem @relation(fields: [productItemId], references: [productItemId], onDelete: Cascade)

  @@unique([cartId, productItemId])
  @@index([cartId])
  @@map("cart_item")
}

model Transaction {
  transactionId   Int             @id @default(autoincrement()) @map("transaction_id")
  transactionType TransactionType @map("transaction_type")
  userId          Int             @map("user_id")
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  date            DateTime        @default(now())
  createdAt       DateTime        @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([transactionType])
  @@map("transactions")
}

model Order {
  orderId            Int         @id @default(autoincrement()) @map("order_id")
  // Buyer FK — orders are derived from selected CartItem rows at
  // checkout, not anchored to a Cart. Order is owned by the user.
  userId             Int         @map("user_id")
  totalPrice         Decimal     @map("total_price") @db.Decimal(12, 2)
  status             OrderStatus @default(pending)
  transactionId      Int?        @map("transaction_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  expiredAt          DateTime?   @map("expired_at")
  // Gift checkout: receipt shows recipient instead of buyer.
  giftRecipientEmail String?     @map("gift_recipient_email") @db.VarChar(80)
  giftMessage        String?     @map("gift_message") @db.VarChar(500)

  /// Stripe payment/refund mapping. NULL in demo mode; live mode
  /// fills paymentIntentId at create, the rest from webhooks.
  stripePaymentIntentId String? @map("stripe_payment_intent_id") @db.VarChar(40)
  stripeChargeId        String? @map("stripe_charge_id") @db.VarChar(40)
  stripeRefundId        String? @map("stripe_refund_id") @db.VarChar(40)
  stripeAmountReceived  Int?    @map("stripe_amount_received")
  stripeAmountRefunded  Int     @default(0) @map("stripe_amount_refunded")

  user        User         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [transactionId])
  items       OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([stripePaymentIntentId])
  @@map("orders")
}

model OrderItem {
  orderItemId   Int     @id @default(autoincrement()) @map("order_item_id")
  orderId       Int     @map("order_id")
  productItemId Int     @map("product_item_id")
  couponId      Int?    @map("coupon_id")
  quantity      Int
  // Phase 45 — renamed price_at_purchase → price_per_unit + widened
  // to (12,2) per the docx report. The semantic stays "the unit price
  // we charged on this line at checkout time".
  pricePerUnit  Decimal @map("price_per_unit") @db.Decimal(12, 2)

  // Phase 33 — snapshot of what was delivered to THIS buyer when the
  // payment_intent.succeeded webhook fired. Snapshotted (not joined
  // live) so a seller editing product_item.delivery_url later doesn't
  // change what an existing buyer sees on /orders/[id]. Null until
  // finalizeOrder() runs.
  deliveredUrl    String?   @map("delivered_url") @db.Text
  deliveredKey    String?   @map("delivered_key") @db.VarChar(80)
  deliveredAt     DateTime? @map("delivered_at")

  order       Order       @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  productItem ProductItem @relation(fields: [productItemId], references: [productItemId])
  coupon      Coupon?     @relation(fields: [couponId], references: [couponId])

  @@index([orderId])
  @@index([productItemId])
  @@map("order_item")
}

// ============================================================================
//  COUPONS
// ============================================================================

model Coupon {
  couponId      Int          @id @default(autoincrement()) @map("coupon_id")
  // Nullable storeId enables "Master Coupons" (platform-wide).
  // Per-store coupons keep storeId set; usage_limit caps total redemptions.
  storeId       Int?         @map("store_id")
  code          String       @db.VarChar(50)
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  usageLimit    Int          @map("usage_limit")
  discountType  DiscountType @map("discount_type")
  discountValue Int          @map("discount_value")
  isActive      Boolean      @default(true) @map("is_active")

  store      Store?        @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  usages     CouponUsage[]
  orderItems OrderItem[]

  // Master-coupon code uniqueness is enforced by a partial index in the migration.
  @@unique([storeId, code])
  @@index([code])
  @@index([isActive])
  @@map("coupon")
}

model CouponUsage {
  usageId   Int      @id @default(autoincrement()) @map("usage_id")
  couponId  Int      @map("coupon_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [couponId], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // One redemption per user per coupon (Business Rule 4.i).
  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usage")
}

// Password reset: token stored as a SHA-256 hex hash so the raw
// value is only ever in the user's email link. 30-min lifetime.
model PasswordResetToken {
  tokenId    Int       @id @default(autoincrement()) @map("token_id")
  userId     Int       @map("user_id")
  // Stored as the SHA-256 hash; raw token is only in the email link.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

// Phase 41 - email verify token, mirrors PasswordResetToken pattern.
// Single-use; the raw token only lives in the email link, the DB
// only stores its SHA-256.
model EmailVerifyToken {
  tokenId    Int       @id @default(autoincrement()) @map("token_id")
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verify_token")
}

// Audit log: destructive admin/seller actions write a row here.
model AuditLog {
  logId      Int      @id @default(autoincrement()) @map("log_id")
  // NULL for system actions (cleanup cron, etc.).
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(60) // e.g. "user.delete", "store.delete", "order.refund"
  targetType String   @map("target_type") @db.VarChar(40) // e.g. "user", "store", "order"
  targetId   Int      @map("target_id")
  meta       Json? // optional snapshot/context
  // Request context. NULL for system actions.
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [userId], onDelete: SetNull)

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

// better-auth tables. PKs are Int (via generateId: "serial") so the
// FKs into users.user_id stay clean.

model Account {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  providerId            String    @map("provider_id") @db.VarChar(40)
  accountId             String    @map("account_id") @db.VarChar(255)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.VarChar(255)
  idToken               String?   @map("id_token") @db.Text
  // Bcrypt hash for credential providers (mirror of User.password).
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique @db.VarChar(120)
  expiresAt  DateTime  @map("expires_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  /// Last successful TOTP step-up; checked by requireRecent2FA on
  /// sensitive routes. NULL = never proven on this session.
  lastTotpAt DateTime? @map("last_totp_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(120)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// Phase 48 — IP-level ban list. Independent from User.bannedAt
/// because IPs aren't tied to a single account (NAT, VPN, shared
/// workstations). Middleware reads cached entries before requests
/// reach the auth layer so abusive networks get blocked early.
model BannedIp {
  bannedIpId  Int       @id @default(autoincrement()) @map("banned_ip_id")
  /// 45 chars covers IPv4 + IPv6 maximum representations.
  ipAddress   String    @unique @map("ip_address") @db.VarChar(45)
  /// Free-form note shown to admins; never echoed to the banned user.
  reason      String?   @db.VarChar(255)
  bannedById  Int       @map("banned_by_id")
  bannedAt    DateTime  @default(now()) @map("banned_at")
  /// NULL = forever; otherwise middleware ignores rows past this time.
  expiresAt   DateTime? @map("expires_at")
  bannedBy    User      @relation("BannedIpBy", fields: [bannedById], references: [userId])

  @@index([ipAddress])
  @@map("banned_ip")
}

/// Phase 49 — Devices the user has confirmed via email-OTP and ticked
/// "Trust this device for 7 days". Subsequent logins from the same
/// browser within `expiresAt` skip the OTP gate. We store only the
/// SHA-256 hash of the cookie value the browser holds, so a DB dump
/// can't be replayed to impersonate a trusted device.
model TrustedDevice {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  /// SHA-256 (hex) of the random 32-byte hex cookie value. Cookie
  /// itself never lands in the DB.
  fingerprintHash String   @unique @map("fingerprint_hash") @db.VarChar(64)
  /// Best-effort label so /profile/edit can list trusted devices
  /// (e.g. "Chrome on Windows"). Derived from User-Agent.
  label           String?  @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at")
  expiresAt       DateTime @map("expires_at")
  user            User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("trusted_device")
}

/// Single-row runtime config. CHECK constraint pins id=1 so we
/// can never accidentally insert a second row.
model SystemSetting {
  id                 Int      @id @default(1)
  /// Hides favourites UI when false; underlying rows are preserved.
  favoritesEnabled   Boolean  @default(true) @map("favorites_enabled")
  /// % of every order the platform keeps. Default 5.00 = sellers
  /// earn 95% of each sale. Maps to Stripe's application_fee_amount.
  platformFeePercent Decimal  @default(5.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}
